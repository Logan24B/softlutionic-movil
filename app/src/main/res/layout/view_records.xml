<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
<Spinner android:id="@+id/module" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Módulo"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Actualizar"/><com.google.android.material.button.MaterialButton android:id="@+id/create" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Crear"/></LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/records" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
