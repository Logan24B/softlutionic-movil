<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/login_bg" android:theme="@style/ThemeOverlay.Softlutionic.Login">
<TextView android:id="@+id/moduleTitle" style="@style/TextAppearance.Softlutionic.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/refresh"/><com.google.android.material.button.MaterialButton android:id="@+id/create" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/create"/></LinearLayout>
