<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/login_background" android:theme="@style/ThemeOverlay.Softlutionic.Login">
    <TextView style="@style/TextAppearance.Softlutionic.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clients_title" android:textSize="26sp" android:accessibilityHeading="true"/>
    <TextView style="@style/TextAppearance.Softlutionic.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/clients_subtitle"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/searchLayout" style="@style/Widget.Softlutionic.LoginInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/clients_search" app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:textColor="@color/login_text" android:contentDescription="@string/clients_search_help"/>
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/filters" style="@style/Widget.Softlutionic.ClientSecondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clients_filters"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.Softlutionic.ClientSecondary" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/refresh" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" app:iconPadding="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="12dp" app:iconTint="@color/login_cyan"/>
    </LinearLayout>
    <TextView android:id="@+id/count" style="@style/TextAppearance.Softlutionic.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
    <TextView android:id="@+id/referenceStatus" style="@style/TextAppearance.Softlutionic.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dashboard_amber" android:visibility="gone"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/records" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp"/>
        <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/login_user" app:tint="@color/login_cyan" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/emptyTitle" style="@style/TextAppearance.Softlutionic.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/emptyBody" style="@style/TextAppearance.Softlutionic.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/create" style="@style/Widget.Softlutionic.ClientAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/clients_new" android:elevation="6dp"/>
</LinearLayout>
