<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/login_surface" app:cardCornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/login_accent" app:rippleColor="@color/login_cyan">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_service_build" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/name" style="@style/TextAppearance.Softlutionic.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:textSize="19sp"/>
        </LinearLayout>
        <TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/dashboard_green" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="27sp" android:autoSizeStepGranularity="1sp"/>
        <TextView android:id="@+id/description" style="@style/TextAppearance.Softlutionic.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="3" android:ellipsize="end"/>
        <TextView android:id="@+id/duration" style="@style/TextAppearance.Softlutionic.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:drawableStart="@drawable/ic_service_schedule" android:drawablePadding="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
